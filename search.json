[{"path":"https://cudaverse.github.io/cudacellr/authors.html","id":null,"dir":"","previous_headings":"","what":"Authors","title":"Authors and Citation","text":"Yaoxiang Li. Author, maintainer.","code":""},{"path":"https://cudaverse.github.io/cudacellr/authors.html","id":"citation","dir":"","previous_headings":"","what":"Citation","title":"Authors and Citation","text":"Li Y (2026). cudacellr: GPU-Aware Single-Cell Analysis Workflows R. R package version 0.1.1, https://cudaverse.github.io/cudacellr/.","code":"@Manual{,   title = {cudacellr: GPU-Aware Single-Cell Analysis Workflows for R},   author = {Yaoxiang Li},   year = {2026},   note = {R package version 0.1.1},   url = {https://cudaverse.github.io/cudacellr/}, }"},{"path":"https://cudaverse.github.io/cudacellr/index.html","id":"cudacellr","dir":"","previous_headings":"","what":"GPU-Aware Single-Cell Analysis Workflows for R","title":"GPU-Aware Single-Cell Analysis Workflows for R","text":"cudacellr R-native single-cell workflow layer cudaverse. composes sparse count processing GPU-aware numerical algorithms keeping features rows cells columns public R boundary.","code":""},{"path":"https://cudaverse.github.io/cudacellr/index.html","id":"current-workflow","dir":"","previous_headings":"","what":"Current workflow","title":"GPU-Aware Single-Cell Analysis Workflows for R","text":"library-size normalization; sparse log-normalization; highly variable feature selection; PCA cudalearnr; k-nearest neighbours cudalearnr; composable end--end workflow result reuses preprocessing stage instead repeating normalization feature selection.","code":""},{"path":"https://cudaverse.github.io/cudacellr/index.html","id":"installation","dir":"","previous_headings":"","what":"Installation","title":"GPU-Aware Single-Cell Analysis Workflows for R","text":"","code":"# install.packages(\"pak\") pak::pak(\"cudaverse/cudacellr\")"},{"path":"https://cudaverse.github.io/cudacellr/index.html","id":"example","dir":"","previous_headings":"","what":"Example","title":"GPU-Aware Single-Cell Analysis Workflows for R","text":"Continue result graph clustering embedding cudaverse end--end workflow. Neighbour search exact uses bounded distance blocks. min(batch_size, cells) * cells distances held instead full cell--cell matrix. Reduce batch_size memory constrained; selected neighbours deterministic change batch size.","code":"library(cudacellr) library(Matrix)  set.seed(1) counts <- Matrix(   matrix(rpois(1000 * 300, lambda = 1.5), 1000, 300),   sparse = TRUE )  fit <- cudacell_workflow(   counts,   n_hvg = 300,   n_components = 20,   k = 15,   batch_size = 128 )  fit$pca fit$neighbors"},{"path":"https://cudaverse.github.io/cudacellr/index.html","id":"object-integration","dir":"","previous_headings":"","what":"Object integration","title":"GPU-Aware Single-Cell Analysis Workflows for R","text":"current API accepts base, Matrix, cudasparse matrices. Native SingleCellExperiment Seurat adapters next integration milestone; intentionally hard dependencies numerical core. installation, device verification, memory advice, common failures, see cudaverse GPU setup troubleshooting guide.","code":""},{"path":"https://cudaverse.github.io/cudacellr/index.html","id":"license","dir":"","previous_headings":"","what":"License","title":"GPU-Aware Single-Cell Analysis Workflows for R","text":"MIT © Yaoxiang Li","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_cell_neighbors.html","id":null,"dir":"Reference","previous_headings":"","what":"Construct a nearest-neighbour representation — cuda_cell_neighbors","title":"Construct a nearest-neighbour representation — cuda_cell_neighbors","text":"Construct nearest-neighbour representation","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_cell_neighbors.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"Construct a nearest-neighbour representation — cuda_cell_neighbors","text":"","code":"cuda_cell_neighbors(   embedding,   k = 15L,   metric = c(\"euclidean\", \"cosine\"),   device = c(\"auto\", \"cuda\", \"cpu\"),   batch_size = 256L )"},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_cell_neighbors.html","id":"arguments","dir":"Reference","previous_headings":"","what":"Arguments","title":"Construct a nearest-neighbour representation — cuda_cell_neighbors","text":"embedding Cell--component matrix cuda_pca result. k Number neighbours. metric Distance metric. device Computation device. batch_size Maximum query rows per exact kNN distance block. Smaller values reduce peak distance memory.","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_cell_neighbors.html","id":"value","dir":"Reference","previous_headings":"","what":"Value","title":"Construct a nearest-neighbour representation — cuda_cell_neighbors","text":"cuda_knn object.","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_cell_neighbors.html","id":"ref-examples","dir":"Reference","previous_headings":"","what":"Examples","title":"Construct a nearest-neighbour representation — cuda_cell_neighbors","text":"","code":"cuda_cell_neighbors(   matrix(rnorm(60), 20, 3),   k = 5,   batch_size = 4,   device = \"cpu\" ) #> <cuda_knn observations=20 k=5 metric=euclidean device=cpu>"},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_cell_pca.html","id":null,"dir":"Reference","previous_headings":"","what":"Run PCA on highly variable single-cell features — cuda_cell_pca","title":"Run PCA on highly variable single-cell features — cuda_cell_pca","text":"Run PCA highly variable single-cell features","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_cell_pca.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"Run PCA on highly variable single-cell features — cuda_cell_pca","text":"","code":"cuda_cell_pca(   counts,   n_components = 30L,   n_hvg = 2000L,   scale. = TRUE,   device = c(\"auto\", \"cuda\", \"cpu\") )"},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_cell_pca.html","id":"arguments","dir":"Reference","previous_headings":"","what":"Arguments","title":"Run PCA on highly variable single-cell features — cuda_cell_pca","text":"counts Feature--cell matrix. n_components Number principal components. n_hvg Number highly variable features. scale. Whether scale selected features PCA. device Device passed cudalearnr::cuda_pca().","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_cell_pca.html","id":"value","dir":"Reference","previous_headings":"","what":"Value","title":"Run PCA on highly variable single-cell features — cuda_cell_pca","text":"cuda_pca object additional features element.","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_cell_pca.html","id":"ref-examples","dir":"Reference","previous_headings":"","what":"Examples","title":"Run PCA on highly variable single-cell features — cuda_cell_pca","text":"","code":"set.seed(2) counts <- matrix(rpois(30 * 20, lambda = 2), 30, 20) cuda_cell_pca(counts, n_components = 3, n_hvg = 10, device = \"cpu\") #> <cuda_pca components=3 device=cpu> #>               PC1          PC2         PC3 #>  [1,]  0.02608630  0.512558175  0.19860552 #>  [2,] -0.36704292  0.393908021  0.27650371 #>  [3,]  0.40757497 -0.209287751 -0.22659441 #>  [4,]  0.01657213 -0.420012007  0.54493624 #>  [5,] -0.27037240  0.199740313  0.07087489 #>  [6,] -0.19268604 -0.054987667 -0.67505649 #>  [7,] -0.34508242 -0.320837803  0.05396706 #>  [8,]  0.23051134  0.005367556  0.14126006 #>  [9,] -0.23326910 -0.457835356  0.16700949 #> [10,] -0.60112065 -0.080064874 -0.15594065"},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_hvg.html","id":null,"dir":"Reference","previous_headings":"","what":"Select highly variable features — cuda_hvg","title":"Select highly variable features — cuda_hvg","text":"Select highly variable features","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_hvg.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"Select highly variable features — cuda_hvg","text":"","code":"cuda_hvg(counts, n_top = 2000L, min_mean = 0)"},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_hvg.html","id":"arguments","dir":"Reference","previous_headings":"","what":"Arguments","title":"Select highly variable features — cuda_hvg","text":"counts Feature--cell count normalized expression matrix. n_top Number features select. min_mean Minimum feature mean.","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_hvg.html","id":"value","dir":"Reference","previous_headings":"","what":"Value","title":"Select highly variable features — cuda_hvg","text":"data frame ordered dispersion feature statistics selected indicator.","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_hvg.html","id":"ref-examples","dir":"Reference","previous_headings":"","what":"Examples","title":"Select highly variable features — cuda_hvg","text":"","code":"set.seed(1) counts <- Matrix::rsparsematrix(20, 10, density = 0.3) counts@x <- abs(round(counts@x * 5)) cuda_hvg(counts, n_top = 5) #>       feature mean   variance dispersion selected #> 17 feature_17  1.1 12.1000000 11.0000000     TRUE #> 6   feature_6  2.0 14.4444444  7.2222222     TRUE #> 12 feature_12  0.7  4.9000000  7.0000000     TRUE #> 3   feature_3  1.2  7.2888889  6.0740741     TRUE #> 9   feature_9  0.7  3.5666667  5.0952381     TRUE #> 16 feature_16  0.7  3.5666667  5.0952381    FALSE #> 1   feature_1  1.0  4.8888889  4.8888889    FALSE #> 8   feature_8  0.9  3.6555556  4.0617284    FALSE #> 10 feature_10  0.9  3.6555556  4.0617284    FALSE #> 14 feature_14  1.4  5.6000000  4.0000000    FALSE #> 4   feature_4  2.5  9.8333333  3.9333333    FALSE #> 15 feature_15  0.5  1.6111111  3.2222222    FALSE #> 2   feature_2  1.9  5.6555556  2.9766082    FALSE #> 5   feature_5  1.7  4.9000000  2.8823529    FALSE #> 7   feature_7  1.3  3.5666667  2.7435897    FALSE #> 13 feature_13  0.9  2.3222222  2.5802469    FALSE #> 11 feature_11  0.4  0.9333333  2.3333333    FALSE #> 19 feature_19  0.4  0.4888889  1.2222222    FALSE #> 20 feature_20  0.2  0.1777778  0.8888889    FALSE #> 18 feature_18  0.0  0.0000000  0.0000000    FALSE"},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_normalize_counts.html","id":null,"dir":"Reference","previous_headings":"","what":"Normalize a single-cell count matrix — cuda_normalize_counts","title":"Normalize a single-cell count matrix — cuda_normalize_counts","text":"Counts expected features rows cells columns.","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_normalize_counts.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"Normalize a single-cell count matrix — cuda_normalize_counts","text":"","code":"cuda_normalize_counts(counts, scale_factor = 10000, log1p = TRUE)"},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_normalize_counts.html","id":"arguments","dir":"Reference","previous_headings":"","what":"Arguments","title":"Normalize a single-cell count matrix — cuda_normalize_counts","text":"counts base matrix, Matrix sparse matrix, cudasparse. scale_factor Target library size. log1p Whether apply log1p() non-zero normalized values.","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_normalize_counts.html","id":"value","dir":"Reference","previous_headings":"","what":"Value","title":"Normalize a single-cell count matrix — cuda_normalize_counts","text":"sparse Matrix::dgCMatrix.","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cuda_normalize_counts.html","id":"ref-examples","dir":"Reference","previous_headings":"","what":"Examples","title":"Normalize a single-cell count matrix — cuda_normalize_counts","text":"","code":"counts <- Matrix::Matrix(matrix(c(1, 0, 3, 2, 4, 1), 3), sparse = TRUE) cuda_normalize_counts(counts) #> 3 x 2 sparse Matrix of class \"dgCMatrix\" #>                        #> [1,] 7.824446 7.957927 #> [2,] .        8.650900 #> [3,] 8.922792 7.265130"},{"path":"https://cudaverse.github.io/cudacellr/reference/cudacell_workflow.html","id":null,"dir":"Reference","previous_headings":"","what":"Run the initial cudacellr workflow — cudacell_workflow","title":"Run the initial cudacellr workflow — cudacell_workflow","text":"Run initial cudacellr workflow","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cudacell_workflow.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"Run the initial cudacellr workflow — cudacell_workflow","text":"","code":"cudacell_workflow(   counts,   n_hvg = 2000L,   n_components = 30L,   k = 15L,   device = c(\"auto\", \"cuda\", \"cpu\"),   batch_size = 256L )"},{"path":"https://cudaverse.github.io/cudacellr/reference/cudacell_workflow.html","id":"arguments","dir":"Reference","previous_headings":"","what":"Arguments","title":"Run the initial cudacellr workflow — cudacell_workflow","text":"counts Feature--cell count matrix. n_hvg Number variable features. n_components PCA components. k Neighbours per cell. device Computation device. batch_size Maximum query rows per exact kNN distance block.","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cudacell_workflow.html","id":"value","dir":"Reference","previous_headings":"","what":"Value","title":"Run the initial cudacellr workflow — cudacell_workflow","text":"list containing normalized counts, variable features, PCA, kNN.","code":""},{"path":"https://cudaverse.github.io/cudacellr/reference/cudacell_workflow.html","id":"ref-examples","dir":"Reference","previous_headings":"","what":"Examples","title":"Run the initial cudacellr workflow — cudacell_workflow","text":"","code":"set.seed(3) counts <- matrix(rpois(40 * 25, 2), 40, 25) cudacell_workflow(   counts, n_hvg = 15, n_components = 5, k = 5, device = \"cpu\" ) #> $normalized #> 40 x 25 sparse Matrix o